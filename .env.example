# YCH 对话模型（密钥只写本地 .env，禁止提交）
# 硅基流动 OpenAI 兼容示例：
#   YCH_CHAT_API_BASE=https://api.siliconflow.cn/v1
#   YCH_CHAT_MODEL=Qwen/Qwen3.5-35B-A3B
#   YCH_CHAT_API_PROTOCOL=openai_compatible
# 2026-09-05 官方人民币价目候选：Qwen/Qwen3.5-35B-A3B。
# Qwen/Qwen2.5-7B-Instruct 只有英文页 USD 标价，受控实跑会被 cost_unbounded 拦截。
# 填写模型名 ≠ 鉴定通过，更不等于打开生产路由或 QQ 外发。
YCH_CHAT_API_BASE=
YCH_CHAT_API_KEY=
YCH_CHAT_MODEL=
YCH_CHAT_API_PROTOCOL=disabled
YCH_CHAT_MODEL_ENABLED=false
YCH_CHAT_TIMEOUT_SECONDS=60
YCH_CHAT_MAX_RETRIES=2
YCH_CHAT_DAILY_REQUEST_LIMIT=200
YCH_CHAT_DAILY_TOKEN_LIMIT=500000
YCH_CHAT_FAILURE_THRESHOLD=5
YCH_CHAT_CIRCUIT_COOLDOWN_SECONDS=300

# YCH 识图（多模态 chat/completions，与文生图完全分开）
# 2026-09-05 官方人民币价目候选：zai-org/GLM-4.5V。
# Qwen/Qwen3-VL-8B-Instruct 无官方人民币单价，受控实跑会被拦截。
YCH_VISION_API_BASE=
YCH_VISION_API_KEY=
YCH_VISION_MODEL=
YCH_VISION_API_PROTOCOL=disabled
YCH_VISION_MODEL_ENABLED=false
YCH_VISION_TIMEOUT_SECONDS=90
YCH_VISION_MAX_RETRIES=1
YCH_VISION_DAILY_REQUEST_LIMIT=40
YCH_VISION_DAILY_TOKEN_LIMIT=200000
YCH_VISION_FAILURE_THRESHOLD=3
YCH_VISION_CIRCUIT_COOLDOWN_SECONDS=300

# 表情包：模型只输出【关键词】，把 png/gif/webp 放到 storage/stickers/<标签>/，不是系统 emoji。
# YCH 图片生成模型（文生图，默认关闭；不要拿来做表情包）
# 2026-09-05 官方人民币价目：Tongyi-MAI/Z-Image-Turbo 为 ¥0.10/张；Kwai-Kolors/Kolors 为 0 元/张。
YCH_IMAGE_API_BASE=
YCH_IMAGE_API_KEY=
YCH_IMAGE_MODEL=
YCH_IMAGE_API_PROTOCOL=disabled
YCH_IMAGE_RESPONSE_FORMAT=b64_json
YCH_IMAGE_MODEL_ENABLED=false
YCH_IMAGE_TIMEOUT_SECONDS=180
YCH_IMAGE_MAX_RETRIES=1
YCH_IMAGE_DAILY_REQUEST_LIMIT=20
YCH_IMAGE_FAILURE_THRESHOLD=3
YCH_IMAGE_CIRCUIT_COOLDOWN_SECONDS=600
YCH_IMAGE_ARTIFACT_MAX_MEGABYTES=20
YCH_IMAGE_ARTIFACT_MAX_PIXELS=40000000
YCH_IMAGE_MAX_ARTIFACTS_PER_TASK=4
YCH_IMAGE_CONTENT_REVIEW_ENABLED=false
YCH_IMAGE_ORPHAN_SCAN_ENABLED=false
YCH_IMAGE_ORPHAN_WORKER_POLL_SECONDS=300
YCH_SHADOW_INFERENCE_ENABLED=false
YCH_MODEL_NETWORK_ENABLED=false
# 模型资格鉴定只走仪表盘 /models：先预览再确认，才会创建 PREPARED 运行。
# 通过只是证据，不会改这些开关，也不会发 QQ。主号只能 /模型 状态（只读）。

# 统计/日摘要模型（独立路由，默认关闭；未配置时用规则摘要）
# 官方人民币价目可与对话共用 Qwen/Qwen3.5-35B-A3B，但凭证和额度仍独立。
YCH_STATS_API_BASE=
YCH_STATS_API_KEY=
YCH_STATS_MODEL=
YCH_STATS_API_PROTOCOL=disabled
YCH_STATS_MODEL_ENABLED=false
YCH_STATS_TIMEOUT_SECONDS=60
YCH_STATS_MAX_RETRIES=1
YCH_STATS_DAILY_REQUEST_LIMIT=40
YCH_STATS_DAILY_TOKEN_LIMIT=100000
YCH_STATS_FAILURE_THRESHOLD=3
YCH_STATS_CIRCUIT_COOLDOWN_SECONDS=300
YCH_WEB_SEARCH_ENABLED=false
YCH_WEB_SEARCH_API_BASE=
YCH_WEB_SEARCH_API_KEY=
# 搜索没有隐式回退：只有 YCH_WEB_SEARCH_ENABLED=true 且配置完整时才构造真实搜索适配器。

# NapCat / OneBot 连接（空库播种用；之后以仪表盘账号分区为准，可改、可多机器人）
YCH_BOT_QQ=2000000002
YCH_OWNER_QQ=2000000001
YCH_NAPCAT_HTTP_URL=http://127.0.0.1:3000
YCH_ONEBOT_WS_PATH=/onebot/v11/ws
YCH_ONEBOT_ACCESS_TOKEN=
# 观察一键启动（scripts/start-observe.bat）不会把外发、回复 worker 或空间开关改成 true。
YCH_INGEST_ENABLED=true
YCH_OUTBOUND_ENABLED=false
YCH_OUTBOUND_POLL_SECONDS=1
YCH_OUTBOUND_MAX_ATTEMPTS=5
YCH_OUTBOUND_RETRY_BASE_SECONDS=30
# 回复运行时默认不启动，且配置上限锁定为只观察。
# 主号点名的 owner-private 步骤可把上限升到 shadow 或 owner_approved。
# owner_approved、limited_auto 或点名的 live auto 才允许打开外发。
# 仓库默认仍关闭。本机生产 auto 覆盖该机器人全部私聊，以及群内真实 @；搜索和文生图仍须单独开门。
YCH_REPLY_WORKER_ENABLED=false
YCH_REPLY_WORKER_POLL_SECONDS=1
YCH_REPLY_RUNTIME_MAX_MODE=observe_only
YCH_REPLY_APPROVAL_TTL_SECONDS=1800
YCH_QZONE_PUBLISH_ENABLED=false
YCH_QZONE_PROFILE_COLLECTION_ENABLED=false
YCH_LIVE_HISTORY_ENABLED=false
YCH_QZONE_WORKER_ENABLED=false
YCH_QZONE_WORKER_POLL_SECONDS=5
YCH_QZONE_SCHEDULE_TOLERANCE_SECONDS=60
YCH_QZONE_DEFAULT_QUIET_START=22:00
YCH_QZONE_DEFAULT_QUIET_END=08:00
YCH_QZONE_DEFAULT_DAILY_LIMIT=1
YCH_QZONE_DEFAULT_MINIMUM_INTERVAL_SECONDS=21600
YCH_QZONE_MAX_FUTURE_DAYS=366
YCH_OWNER_REPORTS_ENABLED=false
YCH_OWNER_REPORT_WORKER_ENABLED=false
YCH_OWNER_REPORT_WORKER_POLL_SECONDS=5
YCH_OWNER_REPORT_DEDUPE_WINDOW_SECONDS=1800
YCH_OWNER_REPORT_DIGEST_LOCAL_TIME=09:00
YCH_PRIVACY_JOBS_ENABLED=false
# 已有数据库需要升级时，先用 SQLite 在线备份生成校验清单；关闭会阻止带迁移的启动。
YCH_MIGRATION_BACKUP_ENABLED=true
# readiness 只报告真实配置/运行状态，不会替你打开以下任何网络或 worker 开关。
# 开启顺序固定为：local_start -> offline_shadow -> 单一 controlled_real_effect 能力。
YCH_DOCUMENT_IMPORT_ENABLED=true
YCH_KNOWLEDGE_PROCESSING_ENABLED=false
YCH_KNOWLEDGE_WORKER_ENABLED=false
YCH_KNOWLEDGE_WORKER_POLL_SECONDS=5
YCH_KNOWLEDGE_WORKER_MAX_ATTEMPTS=3
YCH_KNOWLEDGE_WORKER_RETRY_BASE_SECONDS=60
# 主动消息使用真实日历时间；调度与真实发送是两个独立开关
YCH_PROACTIVE_SCHEDULER_ENABLED=false
YCH_PROACTIVE_SCHEDULER_POLL_SECONDS=5
YCH_PROACTIVE_SCHEDULE_TOLERANCE_SECONDS=60
YCH_PROACTIVE_POLICY_RECHECK_SECONDS=300
YCH_PROACTIVE_DEFAULT_QUIET_START=22:00
YCH_PROACTIVE_DEFAULT_QUIET_END=08:00
YCH_PROACTIVE_DEFAULT_DAILY_LIMIT=3
YCH_PROACTIVE_DEFAULT_MINIMUM_INTERVAL_SECONDS=3600
YCH_PROACTIVE_MAX_FUTURE_DAYS=366
YCH_DOCUMENT_MAX_MEGABYTES=100
YCH_DOCUMENT_MAX_PAGES=2000
YCH_DOCUMENT_OCR_ENABLED=false

# 本机管理后台（仪表盘登录换票；不要与 OneBot / 模型密钥共用）
YCH_ADMIN_HOST=127.0.0.1
YCH_ADMIN_PORT=8765
YCH_ADMIN_ACCESS_TOKEN=
YCH_ADMIN_SESSION_HOURS=8
# 仅供前端开发服务器代理使用；正常端口无需修改
YCH_DASHBOARD_API_PROXY_TARGET=http://127.0.0.1:8765
YCH_TIMEZONE=Asia/Shanghai
YCH_DATABASE_PATH=storage/runtime/ych.sqlite3
# 生产启动与回滚检查表见 docs/STARTUP_READINESS.md；受管文件策略见
# docs/MANAGED_ARTIFACT_RETENTION.md。不要把绝对路径、令牌或备份内容写进仪表盘备注。
